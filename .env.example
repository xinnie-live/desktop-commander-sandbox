# Optional HTTP proxy for image-build downloads and Remote Device HTTP(S)/fetch requests.
# Leave blank when direct Docker container egress is available.
# Docker Desktop/Engine separately needs registry access to pull the pinned base images.
# If the proxy runs on this host, use a port reachable from Docker, for example:
# REMOTE_DEVICE_HTTPS_PROXY=http://host.docker.internal:PORT
REMOTE_DEVICE_HTTP_PROXY=
REMOTE_DEVICE_HTTPS_PROXY=
# Optional comma-separated NO_PROXY host/domain patterns; blank keeps local defaults.
REMOTE_DEVICE_NO_PROXY=
